        "DB_FILE": "data/dev.db",
        "PORT": "3000",
        "APP_PIN": "1234",
        "ADMIN_PIN": "9999",
        "ONLINE_INVITE_CODE": "dev-invite",
        "ONLINE_ADMIN_CODE": "dev-admin"
