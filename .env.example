# Copy to .env on the server and fill in.
DOMAIN=poker.example.com
APP_PIN=change-me
# Separate, longer PIN for whoever manages players and games.
ADMIN_PIN=change-me-too
# Play section: code to create an account, and a different one to register as an administrator.
# Leave a code empty to close that kind of registration.
ONLINE_INVITE_CODE=change-me-three
ONLINE_ADMIN_CODE=change-me-four
# Must match your Traefik setup (these are the defaults).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
